{
  "name": "vuevpn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:native": "python3 scripts/native.py test",
    "native:prepare": "python3 scripts/native.py prepare",
    "native:build": "python3 scripts/native.py build",
    "tauri": "tauri",
    "package": "python3 scripts/package.py"
  },
  "dependencies": { "@tauri-apps/api": "^2.0.0", "@tauri-apps/plugin-dialog": "^2.0.0", "vue": "^3.5.0" },
  "devDependencies": { "@tauri-apps/cli": "^2.0.0", "@vitejs/plugin-vue": "^6.0.0", "@vue/test-utils": "^2.4.0", "@types/node": "^22.0.0", "typescript": "~5.9.0", "vite": "^7.0.0", "vitest": "^3.2.0", "vue-tsc": "^3.0.0", "happy-dom": "^20.0.0" }
}
